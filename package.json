{
  "name": "medicine-ludo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "worker"
  ],
  "scripts": {
    "predev": "npm run build -w client",
    "dev": "concurrently -n worker,client -c cyan,magenta \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "npm run dev -w worker",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "deploy": "npm run build -w client && npm run deploy -w worker",
    "cf:init": "tsx scripts/cf-init.ts",
    "db:migrate": "npm run db:migrate -w worker",
    "db:migrate:remote": "npm run db:migrate:remote -w worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:pdf": "tsx scripts/import-pdf.ts",
    "playtest": "tsx scripts/playtest.ts",
    "print:board": "tsx scripts/print-board.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
